{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit.mjs"],
            "timeout": 400,
            "statusMessage": "프리 커밋 훅: git 명령 확인 중 (커밋이면 lint → build → test)…"
          }
        ]
      }
    ]
  }
}
